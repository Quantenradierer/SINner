# Copy this to  .env  in the repo root on the server (it is git-ignored and
# .dockerignore'd, so it is never baked into the image). Compose injects it
# into the container via `env_file`.

ENVIRONMENT=production
DJANGO_SECRET_KEY=
DJANGO_HOST=schattenakte.de
DJANGO_PORT=443

OPENAI_API_KEY=
MJ_SERVER_ID=
MJ_CHANNEL_ID=
MJ_PRIVATE_DISCORD_TOKEN=

# Optional: auto-create an admin user on first boot
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=
