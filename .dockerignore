# Build context trim. The image only needs backend/ and frontend/build/
# (the frontend is built on the host before `docker compose build`).

# VCS / IDE / tooling
.git
.gitignore
.idea
.mypy_cache
.pre-commit-config.yaml
pyrightconfig.json

# Python
**/__pycache__
**/*.pyc
**/venv
**/.venv
backend/migrations_backup

# Logs / lock files
**/*.log
**/*.lock

# Local data & secrets — must never be baked into the image.
# backend/data holds only mutable state (sqlite DBs, uploaded media) and is
# the mount point of the runtime volume. Static reference data the app reads
# at runtime lives in backend/npc_creator/reference/ so it ships in the image.
.env
backend/.env
backend/data
backups

# Frontend: only frontend/build/ is copied into the image
**/node_modules
frontend/public
frontend/src
frontend/package-lock.json
# generated NPC/location images are served by nginx from the data volume,
# not from the React build — keep only the static placeholder
frontend/build/images/npc_creator
frontend/build/images/npcs

# Docs
docs
CONTEXT.md
README.md
